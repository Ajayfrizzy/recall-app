{
  "name": "recall-analysis-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16 <23"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "fixtures:check": "tsx src/schemas/check-fixtures.ts && tsx src/schemas/check-openai-schema.ts && tsx src/services/check-openai.ts",
    "access:check": "tsx src/services/access-control.check.ts && tsx ../shared/invitation-code.check.ts && tsx src/services/revenuecat.check.ts",
    "access:admin": "node dist/server/src/scripts/access-admin.js",
    "access:admin:dev": "tsx src/scripts/access-admin.ts",
    "db:backup": "node dist/server/src/scripts/sqlite-backup.js",
    "db:restore-test": "node dist/server/src/scripts/sqlite-restore-test.js",
    "openai:schema-check": "tsx src/schemas/check-openai-schema.ts",
    "openai:config-check": "tsx src/services/check-openai.ts",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^5.12.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.9.7",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}
